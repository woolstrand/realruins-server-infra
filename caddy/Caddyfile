# woolstrand.art — Caddy reverse-proxy configuration
#
# ── Domain switch guide ──────────────────────────────────────────────────────
# To switch from woolstrand.art → a different domain in the future:
#   1. Update DNS: point the new domain (A/AAAA) to this VPS.
#   2. Replace every occurrence of "woolstrand.art" with the new domain
#      in this file (but NOT api.woolstrand.art or staging.woolstrand.art).
#   3. Update WORDPRESS_CONFIG_EXTRA in docker-compose.yml the same way.
#   4. Reload: docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# ── API subdomain note ───────────────────────────────────────────────────────
# api.woolstrand.art and staging.woolstrand.art always point to their
# respective Vapor apps and are independent of the main domain.
# ─────────────────────────────────────────────────────────────────────────────

# ── Production ────────────────────────────────────────────────────────────────

# Main site — woolstrand.art
# Routes:
#   /blog*          → WordPress (blog homepage + all posts/pages)
#   /wp-admin*      → WordPress (admin panel — WP_SITEURL is at root)
#   /wp-includes*   → WordPress (core assets)
#   /wp-content*    → WordPress (themes, plugins, uploads)
#   /wp-login.php   → WordPress (login page)
#   /wp-cron.php    → WordPress (cron endpoint)
#   /xmlrpc.php     → WordPress (XML-RPC; disable if unused)
#   /* (catch-all)  → Vapor API (handles /, /view/*, and all API routes)
woolstrand.art {
    # WordPress is DISABLED from outside (Oct 2026): the wordpress:6-apache image
    # in use ships PHP 8.3.31, vulnerable to PHP2Shell (CVE-2026-109618/109619).
    # To re-enable: pull a patched image (PHP >= 8.3.36), then restore the
    # commented-out handles below and remove this block.
    @wordpress path /blog* /wp-admin* /wp-includes* /wp-content* /wp-login.php /wp-cron.php /xmlrpc.php
    handle @wordpress {
        respond "Not found" 404
    }

    # # WordPress blog at /blog path.
    # # WP_HOME  = https://woolstrand.art/blog  (public blog URL)
    # # WP_SITEURL = https://woolstrand.art      (WordPress core at root)
    # # Caddy does NOT strip the /blog prefix; WordPress's .htaccess uses
    # # RewriteBase / and REQUEST_URI is preserved, so WP handles /blog/* correctly.
    # handle /blog* {
    #     reverse_proxy wordpress-prod:80
    # }

    # # WordPress system paths (required because WP_SITEURL has no /blog prefix)
    # handle /wp-admin* {
    #     reverse_proxy wordpress-prod:80
    # }
    # handle /wp-includes* {
    #     reverse_proxy wordpress-prod:80
    # }
    # handle /wp-content* {
    #     reverse_proxy wordpress-prod:80
    # }
    # handle /wp-login.php {
    #     reverse_proxy wordpress-prod:80
    # }
    # handle /wp-cron.php {
    #     reverse_proxy wordpress-prod:80
    # }
    # handle /xmlrpc.php {
    #     reverse_proxy wordpress-prod:80
    # }

    # Vapor app — handles /, /view/*, and all other API paths
    handle {
        reverse_proxy vapor-prod:8080
    }
}

# Dedicated API subdomain — preserved before and after domain migration
api.woolstrand.art {
    reverse_proxy vapor-prod:8080
}

# ── Staging ───────────────────────────────────────────────────────────────────

# Staging API + user-facing Vapor app
staging.woolstrand.art {
    reverse_proxy vapor-staging:8080
}

# phpMyAdmin — staging database admin UI
# Restrict to trusted IPs in production by uncommenting the block below:
#
#   @blocked not remote_ip 203.0.113.1/32
#   respond @blocked "Access denied" 403
#
db.staging.woolstrand.art {
    reverse_proxy phpmyadmin:80
}

# -- One Tap Tips ------
ott.woolstrand.art {
    reverse_proxy onetaptips-prod-web:3000
}

staging.ott.woolstrand.art {
    handle /github-webhook/* {
        reverse_proxy onetaptips-webhook:9000
    }

    handle {
        reverse_proxy onetaptips-staging-web:3000
    }
}